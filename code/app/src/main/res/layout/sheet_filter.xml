<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/yaya_background"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_resource_type"
        android:textColor="@color/yaya_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/filter_type_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_stage_card"
        android:orientation="horizontal"
        android:padding="8dp">

        <RadioButton
            android:id="@+id/filter_type_all"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:text="@string/filter_all"
            android:textColor="@color/yaya_text_primary"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/filter_type_image"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:text="@string/filter_image"
            android:textColor="@color/yaya_text_primary"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/filter_type_video"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:text="@string/filter_video"
            android:textColor="@color/yaya_text_primary"
            android:textStyle="bold" />
    </RadioGroup>

</LinearLayout>
