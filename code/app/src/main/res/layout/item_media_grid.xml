<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_stage_card">

    <ImageView
        android:id="@+id/media_thumbnail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/yaya_surface_high"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/media_kind_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/yaya_text_primary"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/media_thumbnail"
        app:layout_constraintTop_toTopOf="@id/media_thumbnail" />

    <TextView
        android:id="@+id/media_size_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/yaya_text_primary"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@id/media_thumbnail"
        app:layout_constraintEnd_toEndOf="@id/media_thumbnail" />

    <TextView
        android:id="@+id/media_name_text"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/yaya_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/media_thumbnail" />

</androidx.constraintlayout.widget.ConstraintLayout>
