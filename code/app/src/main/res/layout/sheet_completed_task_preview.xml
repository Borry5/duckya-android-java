<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/yaya_background"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/completed_preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/completed_preview_title"
            android:textColor="@color/yaya_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/completed_preview_source_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_queue_summary_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/completed_preview_original_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/completed_preview_original" />

            <Button
                android:id="@+id/completed_preview_compressed_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/completed_preview_compressed" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginTop="14dp"
            android:background="@color/yaya_surface_high">

            <ImageView
                android:id="@+id/completed_preview_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <VideoView
                android:id="@+id/completed_preview_video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/completed_preview_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_queue_summary_card"
            android:lineSpacingExtra="5dp"
            android:padding="14dp"
            android:textColor="@color/yaya_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/completed_preview_close_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="@string/queue_settings_close" />
    </LinearLayout>
</ScrollView>
