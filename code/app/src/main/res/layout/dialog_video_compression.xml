<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_settings_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/video_settings_description"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/video_preset_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/video_preset_high_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_preset_high_quality"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/video_preset_balanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_preset_balanced"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/video_preset_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_preset_share"
                android:textColor="?attr/colorOnSurface" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/video_resolution_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/video_resolution_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/video_resolution_original"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_resolution_original" />

            <RadioButton
                android:id="@+id/video_resolution_1080"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_resolution_1080" />

            <RadioButton
                android:id="@+id/video_resolution_720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_resolution_720" />

            <RadioButton
                android:id="@+id/video_resolution_480"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_resolution_480" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/video_codec_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/video_codec_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/video_codec_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_codec_auto" />

            <RadioButton
                android:id="@+id/video_codec_h265"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_codec_h265" />

            <RadioButton
                android:id="@+id/video_codec_h264"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_codec_h264" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/video_auto_bitrate_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/video_bitrate_auto"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/video_bitrate_value_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/video_bitrate_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="1"
            android:valueTo="20"
            android:stepSize="0.5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/video_audio_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/video_audio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/video_audio_keep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_audio_keep" />

            <RadioButton
                android:id="@+id/video_audio_reduce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_audio_reduce" />

            <RadioButton
                android:id="@+id/video_audio_mute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_audio_mute" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/video_keep_framerate_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_keep_framerate"
            android:textColor="?attr/colorOnSurface" />

        <CheckBox
            android:id="@+id/video_fallback_h264_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_fallback_h264"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/video_settings_close_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/queue_settings_close" />

            <Button
                android:id="@+id/video_settings_apply_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="@string/video_settings_apply" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
