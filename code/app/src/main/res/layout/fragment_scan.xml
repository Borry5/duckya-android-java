<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yaya_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/scan_fixed_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yaya_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/scan_fixed_selection_compress_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/scan_selection_compress" />

        <Button
            android:id="@+id/scan_fixed_selection_delete_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/yaya_danger"
            android:text="@string/scan_selection_delete" />

        <Button
            android:id="@+id/scan_fixed_selection_done_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:minWidth="76dp"
            android:text="@string/scan_selection_done" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp" />
</LinearLayout>
